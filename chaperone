#!/bin/bash
# chaperone: run a script through Chaperone.app.
#
# Programs started from a shell inherit the shell's *responsible process*, and
# under agent tools or terminal multiplexers that is often something macOS
# will not exempt from the XProtect first-launch scan. This shim asks
# LaunchServices (`open`) to start a fresh Chaperone.app instance, which runs
# the script as its child. The app then becomes the responsible process of the
# script and of everything the script starts, so listing Chaperone.app under
# Developer Tools exempts all of them. See README.md for the full story.
#
# usage: chaperone [--wait] [--clean-env] [--cwd DIR] [--log FILE] [--status FILE] -- /abs/script [args...]
#
# What it does, in order:
#   1. parses the options and checks the script path is absolute;
#   2. picks default log and status paths in $TMPDIR, and empties the status file;
#   3. builds `open -n -g -a Chaperone.app --env K=V ... --args <app options> -- script args`
#      and runs it (the app does the allowlist check, not the shim);
#   4. prints log=<path> and status=<path>, and returns at once, or with
#      --wait, polls the status file until the run ends and exits with its code.
#
# Exit codes: the script's own code with --wait; 128+N when signal N ended it;
# 126 when Chaperone refused the script; 125 when Chaperone failed (open
# failed, the app never started, or it quit without a result); 2 for a usage
# error; 0 without --wait once the run has been handed to the app.
#
# Environment: CHAPERONE_APP overrides the app's path. Only the installed app
# should be used for real runs, since that is the one listed in Developer
# Tools.
#
# Written for /bin/bash 3.2 (macOS's): no associative arrays, and empty arrays
# are expanded with ${a[@]+"${a[@]}"} so `set -u` does not trip on them.

set -u

# Where the app is installed. `make install` rewrites this line with the real
# path: ~/Applications/Chaperone.app by default, the opt path under Homebrew,
# /Applications/MacPorts/Chaperone.app under MacPorts.
DEFAULT_APP="$HOME/Applications/Chaperone.app"

app="${CHAPERONE_APP:-$DEFAULT_APP}"

usage() {
    cat <<'EOF'
usage: chaperone [--wait] [--clean-env] [--cwd DIR] [--log FILE] [--status FILE] -- /abs/script [args...]

  --wait        block until the script ends, then exit with its exit code
                (128+N if a signal N ended it, 126 if Chaperone refused it,
                125 if Chaperone failed)
  --clean-env   do not pass this shell's environment to the script
  --cwd DIR     the script's working directory (default: $PWD)
  --log FILE    append the script's stdout and stderr here
                (default: $TMPDIR/chaperone-<timestamp>.log)
  --status FILE app=, pid=, then exit= or signal= lines
                (default: $TMPDIR/chaperone-<timestamp>.status)

The script must lie under a prefix listed in ~/.config/chaperone/allow.
Prints log=<path> and status=<path> on stdout.
To stop a run: kill the app= pid from the status file.
EOF
}

# Prints an error and exits with the usage-error code.
die() { echo "chaperone: $*" >&2; exit 2; }

# Prints $1 as an absolute path, relative to the caller's directory. The app
# runs in another directory, so every path handed to it must be absolute.
absolute() {
    case "$1" in
        /*) printf '%s\n' "$1" ;;
        *) printf '%s/%s\n' "$PWD" "$1" ;;
    esac
}

# --- 1. Options --------------------------------------------------------------

wait_for_end=0
clean_env=0
cwd="$PWD"
log=""
status=""

while [ $# -gt 0 ]; do
    case "$1" in
        --wait) wait_for_end=1 ;;
        --clean-env) clean_env=1 ;;
        --cwd) [ $# -ge 2 ] || die "--cwd needs a directory"; cwd="$2"; shift ;;
        --log) [ $# -ge 2 ] || die "--log needs a file"; log="$2"; shift ;;
        --status) [ $# -ge 2 ] || die "--status needs a file"; status="$2"; shift ;;
        -h|--help) usage; exit 0 ;;
        --) shift; break ;;
        /*) break ;;  # the script, given without a `--` before it
        *) usage >&2; die "unknown option or relative script: $1" ;;
    esac
    shift
done

# Whatever is left is the script and its arguments.
[ $# -ge 1 ] || { usage >&2; die "no script given"; }
script="$1"
shift
case "$script" in
    /*) ;;
    *) die "the script must be an absolute path: $script" ;;
esac

[ -d "$app" ] || die "no Chaperone.app at $app (install Chaperone, or set CHAPERONE_APP)"
cwd="$(absolute "$cwd")"
[ -d "$cwd" ] || die "no such directory: $cwd"

# --- 2. Log and status files -------------------------------------------------

# The timestamp plus this shell's pid keeps two runs started in the same
# second apart.
tmp="${TMPDIR:-/tmp}"
tmp="${tmp%/}"
stamp="$(date +%Y%m%d-%H%M%S)-$$"
[ -n "$log" ] || log="$tmp/chaperone-$stamp.log"
[ -n "$status" ] || status="$tmp/chaperone-$stamp.status"
log="$(absolute "$log")"
status="$(absolute "$status")"

# An empty status file now, so --wait never reads a previous run's exit= line.
# (The app truncates it again when it opens it.)
: > "$status" || die "cannot write the status file $status"

# --- 3. The environment and the open call ------------------------------------

# By default, hand every exported variable over explicitly, one `--env K=V`
# each, so the script gets the caller's environment whatever LaunchServices
# does with open's own. (On macOS 26.5, open also passes its own environment
# to the app it launches.) Names that are not valid identifiers (e.g. bash's
# exported functions) and `_` are skipped.
#
# With --clean-env, nothing is handed over, and open itself runs under
# `env -i` with a minimal base (HOME, USER, LOGNAME, TMPDIR and the default
# PATH), so the script sees only that plus LaunchServices' own variables.
env_args=()
launcher=()
if [ "$clean_env" = 1 ]; then
    launcher=(/usr/bin/env -i "HOME=$HOME" "USER=${USER:-$(id -un)}" "LOGNAME=${LOGNAME:-$(id -un)}"
              "TMPDIR=${TMPDIR:-/tmp}" "PATH=/usr/bin:/bin:/usr/sbin:/sbin")
else
    while IFS= read -r name; do
        case "$name" in
            _|''|*[!A-Za-z0-9_]*) continue ;;
        esac
        env_args+=(--env "$name=${!name}")
    done < <(compgen -e)
fi

echo "log=$log"
echo "status=$status"

# -n: a new instance every time, so runs can overlap.
# -g: start in the background; the app is LSBackgroundOnly anyway.
# Everything after --args reaches the app's argv unchanged.
${launcher[@]+"${launcher[@]}"} /usr/bin/open -n -g -a "$app" ${env_args[@]+"${env_args[@]}"} \
    --args --cwd "$cwd" --log "$log" --status "$status" -- "$script" "$@" \
    || { echo "chaperone: open failed" >&2; exit 125; }

# Without --wait the run is the app's from here on: it does not depend on
# this shell, and killing this shell never stops it.
[ "$wait_for_end" = 1 ] || exit 0

# --- 4. --wait: poll the status file -----------------------------------------

# Exits with the run's result if the status file has one (an exit= or
# signal= line, always the last line the app writes). A refusal's reason is
# shown on stderr.
finish_if_done() {
    local line
    line="$(grep -E '^(exit|signal)=[0-9]+$' "$status" 2>/dev/null | tail -n 1)"
    case "$line" in
        exit=*)
            grep '^refused=' "$status" | sed 's/^refused=/chaperone: refused: /' >&2
            exit "${line#exit=}"
            ;;
        signal=*)
            exit $((128 + ${line#signal=}))
            ;;
    esac
}

# Two ways a run can end without a result line, both reported as 125:
# - the app never writes app=<pid> (it never started). The limit is generous
#   because a freshly built app's own first launch is scanned (40-50 s);
# - the app=<pid> process is gone but no result was written (it crashed or
#   was killed with SIGKILL). The result is re-read once before giving up,
#   since the app writes it just before quitting.
start_limit=300
started="$(date +%s)"
app_pid=""
while :; do
    finish_if_done
    if [ -z "$app_pid" ]; then
        app_pid="$(sed -n 's/^app=\([0-9][0-9]*\)$/\1/p' "$status" | head -n 1)"
        if [ -z "$app_pid" ] && [ $(( $(date +%s) - started )) -gt "$start_limit" ]; then
            echo "chaperone: Chaperone did not start within $start_limit s" >&2
            exit 125
        fi
    elif ! kill -0 "$app_pid" 2>/dev/null; then
        finish_if_done
        echo "chaperone: Chaperone (pid $app_pid) quit without writing an exit status" >&2
        exit 125
    fi
    sleep 0.5
done
